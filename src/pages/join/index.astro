---
import { withBase } from '../../utils/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';

const contactEmail = 'saptarshi.debroy@hunter.cuny.edu';
---

<BaseLayout
  title="Join Us"
  description="Information for prospective students and collaborators interested in working with the Distributed Systems and Security Laboratory at CUNY."
>

  <section class="join-hero">
    <div class="container hero-grid">

      <div class="hero-main">
        <p class="eyebrow">Join DiSSect</p>

        <h1>
          <span class="line">Interested in</span>
          <span class="line muted">working with us?</span>
        </h1>
      </div>

      <div class="hero-side">
        <p>
          We are interested in working with motivated researchers
          who want to explore distributed systems, edge intelligence,
          trustworthy computing, networking, and cybersecurity.
        </p>

        <div class="hero-note">
          <span>Location</span>
          <strong>CUNY · New York</strong>
        </div>
      </div>

    </div>
  </section>

  <section class="pathways">
    <div class="container">

      <header class="section-header">
        <p class="eyebrow">Ways to Connect</p>

        <h2>
          Different paths.{' '}
          <span class="muted">One research community.</span>
        </h2>
      </header>

      <div class="pathway-list">

        <article class="pathway">
          <span class="number">01</span>

          <div class="pathway-title">
            <p class="type">Prospective</p>
            <h3>PhD Students</h3>
          </div>

          <div class="pathway-content">
            <p>
              Students interested in doctoral research with DiSSect should
              first review the lab's current research directions and recent
              publications to understand the technical areas of the group.
            </p>

            <p>
              Admission to a CUNY doctoral program follows the university's
              formal admissions process. Research alignment with the lab does
              not itself constitute admission or funding.
            </p>
          </div>
        </article>

        <article class="pathway">
          <span class="number">02</span>

          <div class="pathway-title">
            <p class="type">Current CUNY</p>
            <h3>Students</h3>
          </div>

          <div class="pathway-content">
            <p>
              Current students who see a strong connection between their
              interests and ongoing DiSSect research can reach out with a
              concise description of their background and the specific problem
              or project they are interested in.
            </p>
          </div>
        </article>

        <article class="pathway">
          <span class="number">03</span>

          <div class="pathway-title">
            <p class="type">Research</p>
            <h3>Collaborators</h3>
          </div>

          <div class="pathway-content">
            <p>
              DiSSect's work intersects with edge and cloud systems,
              cyberinfrastructure, machine learning, networking, privacy,
              trustworthy computing, and resilient applications.
            </p>

            <p>
              Researchers interested in technically complementary work are
              welcome to contact the lab with a concrete collaboration idea.
            </p>
          </div>
        </article>

      </div>

    </div>
  </section>

  <section class="before-contacting">
    <div class="container contact-grid">

      <div>
        <p class="eyebrow">Before Reaching Out</p>

        <h2>
          Make the first message{' '}
          <span class="muted">useful.</span>
        </h2>
      </div>

      <div class="checklist">

        <div class="check">
          <span>01</span>
          <p>
            Look through the lab's research areas and identify the
            direction most relevant to you.
          </p>
        </div>

        <div class="check">
          <span>02</span>
          <p>
            Read at least one recent publication or project related
            to that direction.
          </p>
        </div>

        <div class="check">
          <span>03</span>
          <p>
            Briefly explain your technical background and what specific
            research question interests you.
          </p>
        </div>

        <div class="check">
          <span>04</span>
          <p>
            Include a CV, personal website, GitHub, or publication record
            when those materials help demonstrate relevant experience.
          </p>
        </div>

      </div>

    </div>
  </section>

  <section class="contact-section">
    <div class="container contact-main">

      <div class="contact-heading">
        <p class="eyebrow">Contact</p>

        <h2>
          Start with a{' '}
          <span class="muted">clear research connection.</span>
        </h2>
      </div>

      <div class="contact-card">

        <div>
          <span class="contact-label">Principal Investigator</span>
          <strong>Saptarshi Debroy</strong>
        </div>

        <div>
          <span class="contact-label">Affiliation</span>
          <p>
            Hunter College<br />
            The Graduate Center<br />
            City University of New York
          </p>
        </div>

        <div>
          <span class="contact-label">Email</span>

          <a href={`mailto:${contactEmail}`}>
            {contactEmail}
            <span aria-hidden="true">↗</span>
          </a>
        </div>

      </div>

      <p class="availability-note">
        Research positions and funding availability can change over time.
        Please contact the lab for current information rather than assuming
        that a position is open.
      </p>

    </div>
  </section>

  <section class="explore-bridge">
    <div class="container bridge-grid">

      <div>
        <p class="eyebrow">Explore First</p>

        <h2>
          Understand the work{' '}
          <span class="muted">before reaching out.</span>
        </h2>
      </div>

      <div class="bridge-links">
        <a href={withBase('/research/')}>
          Research{' '}
          <span aria-hidden="true">→</span>
        </a>

        <a href={withBase('/projects/')}>
          Projects{' '}
          <span aria-hidden="true">→</span>
        </a>

        <a href={withBase('/publications/')}>
          Publications{' '}
          <span aria-hidden="true">→</span>
        </a>

        <a href={withBase('/people/')}>
          People{' '}
          <span aria-hidden="true">→</span>
        </a>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .join-hero {
    padding-block: var(--space-hero-y);
    background: var(--color-bg);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(300px, 0.55fr);
    gap: clamp(4rem, 9vw, 10rem);
    align-items: end;
  }

  .join-hero .eyebrow {
    margin-bottom: 2rem;
    color: var(--color-accent);
  }

  h1 {
    max-width: 950px;
    font-size: var(--text-page-hero);
    font-weight: 760;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .line {
    display: block;
  }

  .muted {
    color: var(--color-text-soft);
  }

  .hero-side > p {
    color: var(--color-text-soft);
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.7;
  }

  .hero-note {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-strong);
  }

  .hero-note span {
    color: var(--color-text-faint);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-note strong {
    font-size: 0.78rem;
  }

  .pathways {
    background: #17191e;
    color: white;
    padding-block: var(--space-section-y);
  }

  .section-header {
    margin-bottom: var(--space-section-heading);
  }

  .section-header .eyebrow {
    margin-bottom: 2rem;
    color: #91a7ff;
  }

  .section-header h2 {
    max-width: 950px;
    font-size: var(--text-section-xl);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.06em;
  }

  .pathway-list {
    border-top: 1px solid #393d45;
  }

  .pathway {
    display: grid;
    grid-template-columns: 60px minmax(250px, 0.7fr) minmax(300px, 1fr);
    gap: clamp(2rem, 5vw, 6rem);
    padding-block: clamp(3rem, 5vw, 5rem);
    border-bottom: 1px solid #393d45;
  }

  .number {
    color: #777d88;
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .type {
    margin-bottom: 0.65rem;
    color: #858b95;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .pathway-title h3 {
    font-size: clamp(2rem, 3.4vw, 3.6rem);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .pathway-content {
    max-width: 720px;
  }

  .pathway-content p {
    color: #aeb3bc;
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .pathway-content p + p {
    margin-top: 1.2rem;
  }

  .before-contacting {
    background: #f4f5f7;
    padding-block: var(--space-section-y);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(350px, 1fr);
    gap: clamp(4rem, 10vw, 11rem);
  }

  .before-contacting .eyebrow {
    margin-bottom: 2rem;
    color: var(--color-accent);
  }

  .before-contacting h2 {
    max-width: 650px;
    font-size: var(--text-section-xl);
    font-weight: 700;
    line-height: 0.97;
    letter-spacing: -0.06em;
  }

  .checklist {
    border-top: 1px solid var(--color-border-strong);
  }

  .check {
    display: grid;
    grid-template-columns: 45px minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--color-border-strong);
  }

  .check span {
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .check p {
    color: var(--color-text-soft);
    line-height: 1.7;
  }

  .contact-section {
    background: var(--color-bg);
    padding-block: var(--space-section-y);
  }

  .contact-main {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(350px, 1fr);
    gap: clamp(4rem, 10vw, 11rem);
  }

  .contact-heading .eyebrow {
    margin-bottom: 2rem;
    color: var(--color-accent);
  }

  .contact-heading h2 {
    max-width: 650px;
    font-size: var(--text-section-xl);
    font-weight: 700;
    line-height: 0.97;
    letter-spacing: -0.06em;
  }

  .contact-card {
    border-top: 1px solid var(--color-border-strong);
  }

  .contact-card > div {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-border-strong);
  }

  .contact-label {
    display: block;
    margin-bottom: 0.6rem;
    color: var(--color-text-faint);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-card strong {
    font-size: 1.3rem;
  }

  .contact-card p {
    color: var(--color-text-soft);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .contact-card a {
    display: inline-flex;
    gap: 0.7rem;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .availability-note {
    grid-column: 2;
    color: var(--color-text-faint);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .explore-bridge {
    background: var(--color-accent);
    color: white;
    padding-block: var(--space-section-y);
  }

  .bridge-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.65fr);
    gap: clamp(4rem, 9vw, 9rem);
    align-items: end;
  }

  .explore-bridge .eyebrow {
    margin-bottom: 2rem;
    color: #c7d2fe;
  }

  .explore-bridge h2 {
    font-size: var(--text-section-xl);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.06em;
  }

  .explore-bridge .muted {
    color: #b9c8ff;
  }

  .bridge-links {
    border-top: 1px solid #6f8df5;
  }

  .bridge-links a {
    display: flex;
    justify-content: space-between;
    padding-block: 1rem;
    border-bottom: 1px solid #6f8df5;
    font-size: 0.9rem;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .hero-grid,
    .contact-grid,
    .contact-main,
    .bridge-grid {
      grid-template-columns: 1fr;
    }

    .availability-note {
      grid-column: 1;
    }
  }

  @media (max-width: 700px) {
    .pathway {
      grid-template-columns: 40px minmax(0, 1fr);
    }

    .pathway-content {
      grid-column: 2;
    }
  }

  @media (max-width: 620px) {
    .join-hero {
      padding-block: 5rem 6rem;
    }

    h1 {
      font-size: clamp(3.4rem, 15vw, 5rem);
    }

    .pathway {
      grid-template-columns: 1fr;
    }

    .number,
    .pathway-content {
      grid-column: 1;
    }
  }
</style>
