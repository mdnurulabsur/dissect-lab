---
import '../styles/global.css';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'DiSSect Lab',
  description =
    'Distributed Systems and Security Laboratory — research in distributed systems, edge intelligence, cybersecurity, and trustworthy computing.',
} = Astro.props;

const pageTitle =
  title === 'DiSSect Lab'
    ? title
    : `${title} | DiSSect Lab`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{pageTitle}</title>

    <meta
      name="description"
      content={description}
    />

    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={pageTitle}
    />

    <meta
      name="twitter:description"
      content={description}
    />
  </head>

  <body>
    <a
      class="skip-link"
      href="#main-content"
    >
      Skip to content
    </a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
