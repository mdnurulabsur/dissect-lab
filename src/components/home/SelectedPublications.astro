---
import { withBase } from '../../utils/paths';
import { getCollection } from 'astro:content';

const publications = (await getCollection('publications'))
  .filter((publication) => publication.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="publications-section">
  <div class="container">

    <header class="publications-header">
      <div>
        <p class="eyebrow">Selected Publications</p>

        <h2>
          Recent work from{' '}
          <span>DiSSect.</span>
        </h2>
      </div>

      <p class="intro">
        Selected recent publications across edge intelligence,
        trustworthy computing, cybersecurity, and distributed systems.
      </p>
    </header>

    <div class="publication-list">
      {
        publications.map((publication, index) => (
          <article class="publication">

            <div class="publication-index">
              {String(index + 1).padStart(2, '0')}
            </div>

            <div class="publication-meta">
              <span>{publication.data.year}</span>
              <span>{publication.data.venue}</span>
              <span>{publication.data.type}</span>
            </div>

            <div class="publication-main">
              <h3>{publication.data.title}</h3>

              <p class="authors">
                {publication.data.authors.join(', ')}
              </p>
            </div>

            <div class="publication-action">
              {
                publication.data.doi ? (
                  <a
                    href={publication.data.doi}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Open ${publication.data.title}`}
                  >
                    ↗
                  </a>
                ) : (
                  <span aria-hidden="true">—</span>
                )
              }
            </div>

          </article>
        ))
      }
    </div>

    <footer class="publications-footer">
      <a href={withBase('/publications/')}>
        View all publications{' '}
        <span aria-hidden="true">→</span>
      </a>
    </footer>

  </div>
</section>

<style>
  .publications-section {
    background: var(--color-bg);
    color: var(--color-text);
    padding-block: var(--space-section-y);
  }

  .publications-header {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.55fr);
    gap: clamp(4rem, 9vw, 9rem);
    align-items: end;
    margin-bottom: var(--space-section-heading);
  }

  .publications-header .eyebrow {
    margin-bottom: 2rem;
    color: var(--color-accent);
  }

  h2 {
    max-width: 820px;
    font-size: clamp(2.8rem, 5vw, 5rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.06em;
  }

  h2 span {
    color: var(--color-text-soft);
  }

  .intro {
    color: var(--color-text-soft);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.65;
  }

  .publication-list {
    border-top: 1px solid var(--color-border-strong);
  }

  .publication {
    display: grid;
    grid-template-columns: 50px 150px minmax(0, 1fr) 40px;
    gap: clamp(1.25rem, 3vw, 3rem);
    align-items: start;
    padding-block: clamp(2rem, 3.5vw, 3.25rem);
    border-bottom: 1px solid var(--color-border-strong);
  }

  .publication-index {
    padding-top: 0.25rem;
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .publication-meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 0.15rem;
    color: var(--color-text-faint);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .publication-main {
    max-width: 980px;
  }

  h3 {
    font-size: clamp(1.6rem, 2.6vw, 2.65rem);
    font-weight: 650;
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .authors {
    margin-top: 1rem;
    color: var(--color-text-soft);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .publication-action {
    display: flex;
    justify-content: flex-end;
    padding-top: 0.15rem;
  }

  .publication-action a {
    font-size: 1.25rem;
    transition: transform var(--transition-fast);
  }

  .publication-action a:hover {
    transform: translate(4px, -4px);
  }

  .publications-footer {
    display: flex;
    justify-content: flex-end;
    padding-top: 2.5rem;
  }

  .publications-footer a {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .publications-footer span {
    transition: transform var(--transition-fast);
  }

  .publications-footer a:hover span {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .publications-header {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .publication {
      grid-template-columns: 40px minmax(0, 1fr) 30px;
    }

    .publication-meta {
      grid-column: 2;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
    }

    .publication-main {
      grid-column: 2;
    }

    .publication-action {
      grid-column: 3;
      grid-row: 1 / span 2;
    }
  }

  @media (max-width: 620px) {
    .publication {
      grid-template-columns: 1fr 28px;
      gap: 1rem;
    }

    .publication-index {
      display: none;
    }

    .publication-meta,
    .publication-main {
      grid-column: 1;
    }

    .publication-action {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
